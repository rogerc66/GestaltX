    "This OS build may not support the technique. You can close this screen and try a manual restart later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This OS build may not support the technique. You can close this screen and try a manual restart later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前系统版本可能不支持此方法。你可以关闭此页面，稍后手动重新启动设备。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است این نسخهٔ سیستم‌عامل از این روش پشتیبانی نکند. می‌توانید این صفحه را ببندید و بعداً دستگاه را به‌صورت دستی دوباره راه‌اندازی کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка ОС может не поддерживать данный метод. Можно закрыть этот экран и позже перезагрузить устройство вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản hệ điều hành này có thể không hỗ trợ kỹ thuật trên. Bạn có thể đóng màn hình này và khởi động lại thiết bị thủ công sau."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當前系統版本可能不支持此方法。你可以關閉此頁面，稍後手動重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當前系統版本可能不支援此方法。你可以關閉此頁面，稍後手動重新啟動裝置。"
          }
        }
      }
    },
    "Your device may briefly return to the Lock Screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device may briefly return to the Lock Screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可能会短暂返回锁定屏幕。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است دستگاه برای لحظاتی به صفحهٔ قفل برگردد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство может ненадолго вернуться на экран блокировки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị có thể trở về Màn hình khóa trong giây lát."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設備可能會短暫返回鎖定屏幕。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置可能會短暫返回鎖定螢幕。"
          }
        }
      }
    }
