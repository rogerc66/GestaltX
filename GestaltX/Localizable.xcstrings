        }
      }
    },
    "iOS 26: SystemGroup access is not claimed by upstream. Local plist editing is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26: SystemGroup access is not claimed by upstream. Local plist editing is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26：上游未声明支持 SystemGroup 访问，可编辑本地 plist。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26: پروژهٔ اصلی پشتیبانی از دسترسی به SystemGroup را اعلام نکرده است. ویرایش plist محلی در دسترس است."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26: исходный проект не заявляет доступ к SystemGroup. Доступно редактирование локальных plist."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26: dự án gốc không công bố hỗ trợ truy cập SystemGroup. Có thể chỉnh sửa plist cục bộ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26：上游未聲明支持 SystemGroup 訪問，可編輯本地 plist。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26：上游未宣告支援 SystemGroup 訪問，可編輯本地 plist。"
          }
        }
      }
    },
    "A correctly provisioned App Group is required. Export and backup are available for any document you can open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A correctly provisioned App Group is required. Export and backup are available for any document you can open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要正确配置并签名 App Group。能够打开的文稿均可导出与备份。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "App Group باید به‌درستی پیکربندی و امضا شده باشد. هر سندی که باز می‌کنید قابل صدور و پشتیبان‌گیری است."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется правильно подготовленная и подписанная App Group. Любой открытый документ можно экспортировать и сохранить в резервной копии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần App Group được cấp quyền và ký đúng. Có thể xuất và sao lưu mọi tài liệu bạn mở được."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要正確配置並簽名 App Group。能夠打開的文稿均可導出與備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要正確配置並簽名 App Group。能夠開啟的文稿均可匯出與備份。"
          }
        }
      }
    },
