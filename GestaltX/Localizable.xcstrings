    "MobileGestalt access was denied. Check the OS version and App Group signing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt access was denied. Check the OS version and App Group signing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 访问被拒绝，请检查系统版本与 App Group 签名。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به MobileGestalt رد شد. نسخهٔ سیستم‌عامل و امضای App Group را بررسی کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
