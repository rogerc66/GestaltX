    "NeoSpring will attempt to restart SpringBoard. Save your work first. It may not work on every OS build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring will attempt to restart SpringBoard. Save your work first. It may not work on every OS build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring 将尝试重新启动 SpringBoard，请先保存其他应用中的工作。部分系统版本可能不适用。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring برای راه‌اندازی مجدد SpringBoard تلاش می‌کند. ابتدا کار خود را ذخیره کنید. ممکن است در همهٔ نسخه‌های سیستم‌عامل کار نکند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring попытается перезапустить SpringBoard. Сначала сохраните работу. Метод может работать не во всех сборках ОС."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring sẽ thử khởi động lại SpringBoard. Hãy lưu công việc trước. Một số bản hệ điều hành có thể không hỗ trợ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring 將嘗試重新啓動 SpringBoard，請先保存其他應用中的工作。部分系統版本可能不適用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring 將嘗試重新啟動 SpringBoard，請先儲存其他應用中的工作。部分系統版本可能不適用。"
          }
        }
      }
    },
