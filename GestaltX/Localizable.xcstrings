    "A device restart may be required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。"
          }
        }
      }
    },
    "Restart the device after changing the region.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device after changing the region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地区后需要重新启动设备。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از تغییر منطقه، دستگاه را دوباره راه‌اندازی کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После смены региона перезагрузите устройство."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại thiết bị sau khi đổi vùng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區後需要重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區後需要重新啟動裝置。"
          }
        }
      }
    },
    "Some changes require a device restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes require a device restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改需要重新启动设备。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی تغییرات به راه‌اندازی مجدد دستگاه نیاز دارند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые изменения требуют перезагрузки устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số thay đổi cần khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改需要重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改需要重新啟動裝置。"
          }
        }
      }
    },
    "Restart required. Apple Intelligence also depends on device and region.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart required. Apple Intelligence also depends on device and region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新启动设备。Apple 智能还取决于机型与地区。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی مجدد لازم است. Apple Intelligence به دستگاه و منطقه نیز بستگی دارد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется перезагрузка. Доступность Apple Intelligence также зависит от устройства и региона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khởi động lại. Apple Intelligence còn tùy thuộc vào thiết bị và vùng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啓動設備。Apple 智能還取決於機型與地區。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啟動裝置。Apple 智慧還取決於機型與地區。"
          }
        }
      }
    },
    "Restart the device, then reopen Settings. Pencil hardware support is still required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device, then reopen Settings. Pencil hardware support is still required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动设备后再打开“设置”，仍需要 Apple Pencil 硬件支持。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه را دوباره راه‌اندازی کنید و تنظیمات را باز کنید. پشتیبانی سخت‌افزاری Apple Pencil همچنان لازم است."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузите устройство и снова откройте «Настройки». Требуется аппаратная поддержка Apple Pencil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại thiết bị rồi mở lại Cài đặt. Thiết bị vẫn cần phần cứng hỗ trợ Apple Pencil."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啓動設備後再打開“設定”，仍需要 Apple Pencil 硬件支持。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動裝置後再開啟“設定”，仍需要 Apple Pencil 硬體支援。"
          }
        }
      }
    },
    "Respring first. Restart the device if the change does not appear.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respring first. Restart the device if the change does not appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先执行注销，若未生效则重新启动设备。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا ری‌اسپرینگ کنید. اگر تغییر دیده نشد، دستگاه را دوباره راه‌اندازی کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выполните респринг. Если изменения не появились, перезагрузите устройство."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy respring trước. Nếu thay đổi chưa xuất hiện, hãy khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先執行註銷，若未生效則重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "先執行登出，若未生效則重新啟動裝置。"
          }
        }
      }
    },
    "Write verified. Some features require a device restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write verified. Some features require a device restart."
