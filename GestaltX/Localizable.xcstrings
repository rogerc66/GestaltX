    "Selections are staged until you review and apply them. Capability flags do not add missing hardware.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selections are staged until you review and apply them. Capability flags do not add missing hardware."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选更改会先暂存，查看后再统一应用。功能标记无法增加设备缺少的硬件。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزینه‌ها تا زمان بازبینی و اعمال، موقتاً ذخیره می‌شوند. پرچم‌های قابلیت، سخت‌افزاری را که دستگاه ندارد اضافه نمی‌کنند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения сохраняются до просмотра и применения. Флаги функций не добавляют отсутствующее оборудование."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lựa chọn được tạm lưu cho đến khi bạn xem lại và áp dụng. Cờ tính năng không bổ sung phần cứng còn thiếu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所選更改會先暫存，查看後再統一應用。功能標記無法增加設備缺少的硬件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所選更改會先暫存，檢視後再統一應用。功能標記無法增加裝置缺少的硬體。"
          }
        }
      }
    },
    "iPadOS CacheData conversion is not enabled for these OS builds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadOS CacheData conversion is not enabled for these OS builds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些系统版本尚未开放 iPadOS CacheData 转换。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیل CacheData به حالت iPadOS برای این نسخه‌های سیستم‌عامل فعال نیست."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразование CacheData для режима iPadOS не включено для этих сборок ОС."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển đổi CacheData sang chế độ iPadOS chưa được bật cho các bản hệ điều hành này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些系統版本尚未開放 iPadOS CacheData 轉換。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些系統版本尚未開放 iPadOS CacheData 轉換。"
          }
        }
      }
    },
    "Unverified byte-offset patches are excluded. Use supported presets or inspect individual fields.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverified byte-offset patches are excluded. Use supported presets or inspect individual fields."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未接入未经验证的偏移补丁。你可以使用已有预设或查看具体字段。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وصله‌های تأییدنشده با جابه‌جایی بایت کنار گذاشته شده‌اند. از پیش‌تنظیم‌های پشتیبانی‌شده استفاده کنید یا فیلدها را جداگانه بررسی کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непроверенные патчи по смещению байтов исключены. Используйте поддерживаемые предустановки или проверьте отдельные поля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không sử dụng bản vá độ lệch byte chưa được xác minh. Hãy dùng thiết lập sẵn được hỗ trợ hoặc kiểm tra từng trường."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "未接入未經驗證的偏移補丁。你可以使用已有預設或查看具體字段。"
          }
        },
        "zh-Hant-TW": {
