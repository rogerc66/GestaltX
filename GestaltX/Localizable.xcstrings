    "Device backups stay linked to this installation. Imported files are kept separate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device backups stay linked to this installation. Imported files are kept separate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机备份与本次安装关联，导入文件的备份会单独保存。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه‌های پشتیبان دستگاه به همین نصب متصل می‌مانند. فایل‌های واردشده جدا نگه داشته می‌شوند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии устройства связаны с этой установкой. Импортированные файлы хранятся отдельно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu thiết bị được liên kết với lần cài đặt này. Tệp đã nhập được lưu riêng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本機備份與本次安裝關聯，導入文件的備份會單獨保存。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本機備份與本次安裝關聯，匯入檔案的備份會單獨儲存。"
          }
        }
      }
    },
