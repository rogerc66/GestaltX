    "A backup is created before writing. The result is read back and compared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup is created before writing. The result is read back and compared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入前会创建备份，写入后会回读并比较内容。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از نوشتن، نسخهٔ پشتیبان ساخته می‌شود. نتیجه دوباره خوانده و مقایسه می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед записью создаётся резервная копия. Затем результат считывается и сравнивается."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu được tạo trước khi ghi. Kết quả được đọc lại và so sánh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會創建備份，寫入後會回讀並比較內容。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會建立備份，寫入後會回讀並比較內容。"
          }
        }
      }
    },
    "This edits the opened file in GestaltX. Export it to save a copy; the system file is not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edits the opened file in GestaltX. Export it to save a copy; the system file is not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅编辑 GestaltX 中打开的文件。请导出以保存副本，系统文件不会被修改。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار فایل بازشده در GestaltX را ویرایش می‌کند. برای نگه‌داشتن کپی، آن را صادر کنید؛ فایل سیستم تغییر نمی‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяется файл, открытый в GestaltX. Экспортируйте его, чтобы сохранить копию. Системный файл не изменяется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này chỉnh sửa tệp đang mở trong GestaltX. Hãy xuất để lưu một bản sao; tệp hệ thống không thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅編輯 GestaltX 中打開的文件。請導出以保存副本，系統文件不會被修改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅編輯 GestaltX 中開啟的檔案。請匯出以儲存副本，系統檔案不會被修改。"
          }
        }
      }
    },
