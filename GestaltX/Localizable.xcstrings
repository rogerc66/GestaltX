        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入已验证。部分功能需要重新启动设备才能生效。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن تأیید شد. برخی قابلیت‌ها به راه‌اندازی مجدد دستگاه نیاز دارند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись проверена. Некоторые функции требуют перезагрузки устройства."
