    "The deletion is staged. The device file changes only after you apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion is staged. The device file changes only after you apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除操作会先暂存，应用后才会修改设备文件。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف موقتاً ثبت می‌شود. فایل دستگاه فقط پس از اعمال تغییر می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление отложено. Файл на устройстве изменится только после применения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa được tạm lưu. Tệp trên thiết bị chỉ thay đổi sau khi bạn áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
