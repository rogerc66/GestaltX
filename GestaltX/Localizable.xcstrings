    "Set the generative models capability. Availability also depends on hardware, region and Apple services.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the generative models capability. Availability also depends on hardware, region and Apple services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置生成式模型功能标记，可用性仍取决于硬件、地区与 Apple 服务。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرچم مدل‌های مولد را تنظیم کنید. دسترس‌پذیری به سخت‌افزار، منطقه و خدمات Apple نیز بستگی دارد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить флаг генеративных моделей. Доступность также зависит от оборудования, региона и сервисов Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt cờ mô hình tạo sinh. Khả năng sử dụng còn tùy thuộc vào phần cứng, vùng và dịch vụ Apple."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定生成式模型功能標記，可用性仍取決於硬件、地區與 Apple 服務。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "設定生成式模型功能標記，可用性仍取決於硬體、地區與 Apple 服務。"
          }
        }
      }
    },
