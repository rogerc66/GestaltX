    "The current document is backed up first. Device restores are verified after writing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current document is backed up first. Device restores are verified after writing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先备份当前文稿。本机恢复会在写入后进行验证。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا از سند فعلی پشتیبان گرفته می‌شود. بازیابی روی دستگاه پس از نوشتن تأیید می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создаётся копия текущего документа. Восстановление на устройстве проверяется после записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu hiện tại được sao lưu trước. Việc khôi phục thiết bị được xác minh sau khi ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份當前文稿。本機恢復會在寫入後進行驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份當前文稿。本機恢復會在寫入後進行驗證。"
          }
        }
      }
    },
