        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رفتار نمایشگر به پنل بستگی دارد. ممکن است مصرف انرژی و خطر سوختگی تصویر افزایش یابد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
